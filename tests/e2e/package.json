{
  "name": "jantama-records-e2e",
  "private": true,
  "scripts": {
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:ui": "npx playwright test --ui",
    "test:pages": "npx playwright test pages/",
    "test:features": "npx playwright test features/",
    "stack:up": "docker compose -f ../../docker-compose.test.yml up -d --build --wait",
    "stack:down": "docker compose -f ../../docker-compose.test.yml down -v",
    "setup": "npx playwright install chromium --with-deps",
    "lint": "npx eslint .",
    "typecheck": "npx tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.2.0",
    "typescript-eslint": "^8.58.1"
  }
}
